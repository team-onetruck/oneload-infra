# One origin for the demo: the web client, the API and the street-view photos.
# Runs in the "caddy" service of compose.yaml; Tailscale Funnel exposes it as
# https://baki-macbookpro.tail3286a4.ts.net:10000/.
{
	auto_https off
}

:4173 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	# Panoramas come from oneload-data (~/hangil-data), so a new survey photo needs no client build.
	handle /panos/* {
		root * /srv/data
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Web client build (oneload-app), copied to ~/hangil-demo/dist.
	handle {
		root * /srv/web

		# Vite fingerprints everything under /assets, so it can be cached forever.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
